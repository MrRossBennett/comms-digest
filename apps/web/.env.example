VITE_BASE_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:password@localhost:5434/comms_digest"
# You can also use Docker Compose to set up a local PostgreSQL database:
# docker-compose up -d

# vp run auth:secret
BETTER_AUTH_SECRET=

# Passwordless email
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Inngest dev server (required for local background job development)
INNGEST_DEV=http://localhost:8288

# Day Plan SMS delivery (the fake in-memory channel is used locally when omitted)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public URL Twilio signs for inbound messages and delivery callbacks
TWILIO_WEBHOOK_URL=http://localhost:3000/api/twilio

# Intelligence experiment
ANTHROPIC_API_KEY=
BRAINTRUST_API_KEY=

# In Google Cloud, set the callback URI to:
# http://localhost:3000/api/auth/callback/google
